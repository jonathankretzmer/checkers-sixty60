# Checkers Sixty60 app API credentials.
#
# These are NOT bundled with the source. They are values the official Checkers
# Sixty60 mobile app sends on its login / OTP / profile calls, which you must
# capture yourself (see AGENTS.md "Traffic Capture / Debugging") and provide
# here.
#
# Only the login / OTP flow needs them. If you already have a saved session
# (~/.checkers-sixty60/auth.json) every other command works without these set.
#
# Usage:
#   - copy this file to `.env` (which is gitignored) and fill in real values,
#     then run under bun (auto-loads .env) or `node --env-file=.env ...`
#     (Node >= 20.6); the published CLI also loads `.env` from the working
#     directory via dotenv.
#   - or set them in the process environment directly.
#   - Docker: pass them with `env_file: .env` / `-e` (never bake into the image).
#   - MCP clients (Claude Desktop, etc.): put them in the server's `env` block.

# x-api-key header on the /users/verify call
SIXTY60_API_KEY=

# x-api-key header on the OTP request / verify calls
SIXTY60_API_KEY_AUTH=

# Bearer token on the customer-profile call
SIXTY60_PROFILE_TOKEN=

# --- Optional: at-rest encryption for stored session state -------------------
# base64 of 32 random bytes (`openssl rand -base64 32`). Unset = plaintext JSON.
# SIXTY60_STATE_KEY=
